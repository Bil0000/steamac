# Proton source the vrclient_x64 patches apply to (patches/, in order). Proton's vrclient_x64 is Wine code,
# LGPL-2.1-or-later; the patches keep that licence. Rebuild vrclient_x64.dll from the patched tree with Proton's
# build (make -C build module=vrclient_x64) and replace it in the compat tool's lib/wine/x86_64-windows/.
PROTON_REPO=https://github.com/ValveSoftware/Proton
PROTON_BRANCH=proton_11.0
PROTON_COMMIT=bc896217ffcd67f892f952b010f898fe7bd0f0a1
