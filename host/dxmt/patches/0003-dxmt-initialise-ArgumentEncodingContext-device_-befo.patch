From a835a8ca8bbb4dc66dfe25ba93b4400b964d5deb Mon Sep 17 00:00:00 2001
From: StonkGuy <68372320+StonkGuy@users.noreply.github.com>
Date: Sat, 10 Oct 2026 15:50:17 +0300
Subject: [PATCH] dxmt: initialise ArgumentEncodingContext::device_ before its
 command contexts

Members are constructed in declaration order. device_ was declared last,
but ClearUAV's constructor (clear_uav_cmd, declared earlier) already
creates its compute pipelines through getComputePipeline(), which uses
ctx.device_: those pipelines were requested on an uninitialised device
handle. It went unnoticed where the heap happened to hold a previous
context's device there; VRChat passed 0x316cf2e0 every launch. device_
is now declared (and initialised) right after lib.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/dxmt/dxmt_context.cpp | 2 +-
 src/dxmt/dxmt_context.hpp | 4 +++-
 2 files changed, 4 insertions(+), 2 deletions(-)

diff --git a/src/dxmt/dxmt_context.cpp b/src/dxmt/dxmt_context.cpp
index c8cd06d..83dba39 100644
--- a/src/dxmt/dxmt_context.cpp
+++ b/src/dxmt/dxmt_context.cpp
@@ -31,6 +31,7 @@ namespace dxmt {
 
 ArgumentEncodingContext::ArgumentEncodingContext(CommandQueue &queue, WMT::Device device, InternalCommandLibrary &lib) :
     lib(lib),
+    device_(device),
     emulated_cmd(device, lib, *this),
     clear_rt_cmd(device, lib, *this),
     blit_depth_stencil_cmd(device, lib, *this),
@@ -38,7 +39,6 @@ ArgumentEncodingContext::ArgumentEncodingContext(CommandQueue &queue, WMT::Devic
     mv_scale_cmd(device, lib, *this),
     tile_barrier_cmd(device, lib, *this),
     timestamp_state_(device),
-    device_(device),
     queue_(queue) {
   dummy_sampler_info_.support_argument_buffers = true;
   dummy_sampler_info_.border_color = WMTSamplerBorderColorTransparentBlack;
diff --git a/src/dxmt/dxmt_context.hpp b/src/dxmt/dxmt_context.hpp
index 4fd51a7..6b08df0 100644
--- a/src/dxmt/dxmt_context.hpp
+++ b/src/dxmt/dxmt_context.hpp
@@ -830,6 +830,9 @@ public:
   uint32_t tess_threads_per_patch;
 
   InternalCommandLibrary &lib;
+  /* declared before the command contexts below: their constructors build pipelines through this
+     context (ClearUAV calls getComputePipeline, which uses device_) */
+  WMT::Device device_;
   EmulatedCommandContext emulated_cmd;
   ClearRenderTargetContext clear_rt_cmd;
   DepthStencilBlitContext blit_depth_stencil_cmd;
@@ -918,7 +921,6 @@ private:
 
   uint64_t intrapass_barrier_control_bits_ = 0;
 
-  WMT::Device device_;
   CommandQueue& queue_;
 };
 
