# DXMT source behind libwmtr_host.dylib (the DXMT graphics path), pinned. host/dxmt/patches/ apply on
# top of it in order. DXMT is LGPL-2.1-or-later; scripts/gpl-sources.sh ships this tarball, the patches and
# wmtr/ (which builds winemetal_unix.c and airconv from this source into the library) with each release.
DXMT_REPO=https://github.com/3Shain/dxmt
DXMT_COMMIT=4ddb20e54672c0cb56115ce80d6db1beef94ae28
DXMT_URL=https://github.com/3Shain/dxmt/archive/4ddb20e54672c0cb56115ce80d6db1beef94ae28.tar.gz
DXMT_SHA256=38ca954fe99963929d0a21fb089c42c097a4cc15c8253bf45ad2af632c4b5fc3
# The statically linked LLVM (airconv's shader compiler); licence text in LICENSES/.
LLVM_VERSION=15.0.7
