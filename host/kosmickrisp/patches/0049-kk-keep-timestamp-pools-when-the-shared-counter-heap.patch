From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: steamac <steamac@local>
Date: Sat, 14 Nov 2026 19:45:57 +0300
Subject: [PATCH] kk: keep timestamp pools when the shared counter heaps are
 full

Metal allows 32 counter heaps per process, and every guest application's
VkDevice shares them under virglrenderer: 16 timestamp pools of 8192
(vkd3d-proton's size) take all of them. A UE5 game creates several such
pools; with a second game or Steam's own devices alive, vkCreateQueryPool
failed with VK_ERROR_OUT_OF_DEVICE_MEMORY ("too many heaps already
allocated in this process or on the system"), Venus lost the pool and the
game's GPU context, and Bodycam closed itself during its first start.

A pool that gets no heap entries is still created. Its timestamps are
written as 0 and become available at once, so GPU timing statistics read
0 for that pool and nothing else changes.
---
 src/kosmickrisp/vulkan/kk_query_pool.c | 23 +++++++++++++++++++----
 1 file changed, 19 insertions(+), 4 deletions(-)

diff --git a/src/kosmickrisp/vulkan/kk_query_pool.c b/src/kosmickrisp/vulkan/kk_query_pool.c
index adfe414..4976157 100644
--- a/src/kosmickrisp/vulkan/kk_query_pool.c
+++ b/src/kosmickrisp/vulkan/kk_query_pool.c
@@ -331,12 +331,16 @@ kk_CreateQueryPool(VkDevice device, const VkQueryPoolCreateInfo *pCreateInfo,
       }
       result = kk_ts_alloc_chunks(dev, pool->ts.chunks, chunk_count);
       if (result != VK_SUCCESS) {
+         /* Every shared counter heap is taken (Metal allows 32 per process,
+          * shared by every guest application). Failing the pool lost the
+          * game's GPU context through Venus; keep the pool with no counter
+          * heap instead: its timestamps read 0. */
          vk_free2(&dev->vk.alloc, pAllocator, pool->ts.chunks);
          pool->ts.chunks = NULL;
-         kk_DestroyQueryPool(device, kk_query_pool_to_handle(pool), pAllocator);
-         return result;
+         result = VK_SUCCESS;
+      } else {
+         pool->ts.chunk_count = chunk_count;
       }
-      pool->ts.chunk_count = chunk_count;
    }
 
    if (pCreateInfo->flags & VK_QUERY_POOL_CREATE_RESET_BIT_KHR)
@@ -487,9 +491,20 @@ kk_CmdWriteTimestamp2(VkCommandBuffer commandBuffer,
    VK_FROM_HANDLE(kk_cmd_buffer, cmd, commandBuffer);
    VK_FROM_HANDLE(kk_query_pool, pool, queryPool);
    struct kk_device *dev = kk_cmd_buffer_device(cmd);
-   assert(kk_pool_is_ts(pool) && pool->ts.chunks);
+   assert(kk_pool_is_ts(pool));
 
    uint32_t count = kk_mv_query_count(cmd);
+
+   /* A pool created without counter heap entries: the queries become
+    * available with a timestamp of 0. */
+   if (pool->ts.chunks == NULL) {
+      for (uint32_t i = 0; i < count; i++) {
+         uint64_t addr = kk_query_report_addr(dev, pool, query + i);
+         kk_cmd_write(cmd, (struct libkk_imm_write){addr, 0});
+         kk_cmd_write(cmd, (struct libkk_imm_write){addr + 4, 0});
+      }
+      return;
+   }
    enum mtl_render_stages mtl_stage =
       kk_pipeline_stages_to_mtl_render_stage(stage);
 
-- 
