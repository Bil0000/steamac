From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: steamac <steamac@local>
Date: Sun, 15 Nov 2026 20:05:00 +0300
Subject: [PATCH] kk: release a never committed Metal command buffer before its
 allocator reset

A Metal 4 command buffer that began and was never committed still owns the
command allocator memory of its recording. Since the allocators are reset
when their command buffer is reset or destroyed, a recorded command buffer
that was never submitted kept its stale Metal command buffers while the
reset allocators went to the next recording. When a stale one began again or
was released, Metal freed memory the other recording used, and that commit
crashed in -[IOGPUMetal4CommandBuffer fillCommandBufferArgs:].

vkd3d-proton leaves such command buffers for every closed D3D12 command list
that is never executed, then resets the pool. Release every Metal command
buffer of an uncommitted recording before the allocator reset and take a new
one at the next begin. Committed command buffers are reused as before.

Generated-by: LLM
---
 src/kosmickrisp/vulkan/kk_cmd_buffer.c | 22 ++++++++++++++++------
 src/kosmickrisp/vulkan/kk_cmd_buffer.h |  1 +
 src/kosmickrisp/vulkan/kk_queue.c      |  1 +
 3 files changed, 18 insertions(+), 6 deletions(-)

diff --git a/src/kosmickrisp/vulkan/kk_cmd_buffer.c b/src/kosmickrisp/vulkan/kk_cmd_buffer.c
index 017f958..7d606ce 100644
--- a/src/kosmickrisp/vulkan/kk_cmd_buffer.c
+++ b/src/kosmickrisp/vulkan/kk_cmd_buffer.c
@@ -192,6 +192,15 @@ release_allocators(struct kk_cmd_buffer *cmd)
 {
    struct kk_cmd_pool *pool = kk_cmd_buffer_pool(cmd);
 
+   if (cmd->metal.uncommitted) {
+      util_dynarray_foreach(&cmd->metal.cmd_bufs, mtl_command_buffer *,
+                            cmd_buf)
+         mtl_release(*cmd_buf);
+      util_dynarray_clear(&cmd->metal.cmd_bufs);
+      cmd->metal.cmd_buf = NULL;
+      cmd->metal.uncommitted = false;
+   }
+
    if (cmd->metal.allocator) {
       mtl_command_allocator_reset(cmd->metal.allocator);
       kk_cmd_pool_return_allocator(pool, cmd->metal.allocator);
@@ -340,6 +349,12 @@ kk_BeginCommandBuffer(VkCommandBuffer commandBuffer,
    VK_FROM_HANDLE(kk_cmd_buffer, cmd, commandBuffer);
    struct kk_cmd_pool *pool = kk_cmd_buffer_pool(cmd);
 
+   vk_command_buffer_begin(&cmd->vk, pBeginInfo);
+   cmd->one_time_submit =
+      pBeginInfo->flags & VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+   cmd->replay = false;
+   memset(&cmd->record, 0, sizeof(cmd->record));
+
    /* If this is the first time starting the command buffer allocate Metal
     * resources */
    if (cmd->metal.cmd_buf == NULL) {
@@ -353,12 +368,6 @@ kk_BeginCommandBuffer(VkCommandBuffer commandBuffer,
                                       cmd->vk.base.object_name);
    }
 
-   vk_command_buffer_begin(&cmd->vk, pBeginInfo);
-   cmd->one_time_submit =
-      pBeginInfo->flags & VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
-   cmd->replay = false;
-   memset(&cmd->record, 0, sizeof(cmd->record));
-
    /* vk_command_buffer_begin will reset the command buffer meaning the
     * allocator may be returned to the pool. Request a new one. */
    if (cmd->metal.allocator == NULL) {
@@ -374,6 +383,7 @@ kk_BeginCommandBuffer(VkCommandBuffer commandBuffer,
    cmd->metal.encoder_count = 0;
    cmd->metal.pre_gfx.encoder_count = 0;
    mtl_begin_command_buffer(cmd->metal.cmd_buf, cmd->metal.allocator);
+   cmd->metal.uncommitted = true;
 
    return VK_SUCCESS;
 
diff --git a/src/kosmickrisp/vulkan/kk_cmd_buffer.h b/src/kosmickrisp/vulkan/kk_cmd_buffer.h
index 99a2d22..d2e86ca 100644
--- a/src/kosmickrisp/vulkan/kk_cmd_buffer.h
+++ b/src/kosmickrisp/vulkan/kk_cmd_buffer.h
@@ -289,6 +289,7 @@ struct kk_cmd_buffer {
       bool render_first;
       mtl_render_encoder *render;
       mtl_compute_encoder *compute;
+      bool uncommitted;
       /* Compute pass of pre_gfx dispatches recorded while the render encoder
        * is open (cs_get_pre_gfx), at the end of the Metal command buffer
        * committed right before the render encoder's: the one the render
diff --git a/src/kosmickrisp/vulkan/kk_queue.c b/src/kosmickrisp/vulkan/kk_queue.c
index e0f5823..8e91362 100644
--- a/src/kosmickrisp/vulkan/kk_queue.c
+++ b/src/kosmickrisp/vulkan/kk_queue.c
@@ -519,6 +519,7 @@ kk_queue_commit(struct kk_queue *queue, struct kk_cmd_buffer *cmd,
 
    /* The recording's Metal command buffers in order, a render encoder's
     * pre_gfx pass in one before the render encoder's (cs_get_pre_gfx) */
+   cmd->metal.uncommitted = false;
    mtl_command_queue_commit(
       queue->mtl_handle, util_dynarray_begin(&cmd->metal.cmd_bufs),
       util_dynarray_num_elements(&cmd->metal.cmd_bufs, mtl_command_buffer *),
