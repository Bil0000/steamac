From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: steamac <steamac@local>
Date: Sun, 15 Nov 2026 14:59:46 +0300
Subject: [PATCH] kk: reset Metal command allocators and keep few of them

A Metal 4 command allocator holds the memory of every command recorded with
it until it is reset. The allocator went back to the command pool at
vkEndCommandBuffer and was reused without a reset, also by the queue's
re-recordings of resubmitted command buffers while the previous one was
still on the GPU, so it kept growing. Bodycam's process footprint grew to
43 GB in a match (23 GB of allocators); macOS ran out of application memory.

A command buffer now keeps its allocator until it is reset or destroyed
(then it is not pending, so the GPU is done with it), resets it then, and
the pool keeps at most 4 allocators of at most 4 MiB each for reuse. The
others are released.
---
 src/kosmickrisp/bridge/mtl_command_buffer.h     |  1 +
 src/kosmickrisp/bridge/mtl_command_buffer.m     |  8 ++++++++
 .../bridge/stubs/mtl_command_buffer.c           |  6 ++++++
 src/kosmickrisp/vulkan/kk_cmd_buffer.c          | 17 ++++++++++++++++-
 src/kosmickrisp/vulkan/kk_cmd_pool.c            | 12 ++++++++++++
 src/kosmickrisp/vulkan/kk_cmd_pool.h            |  5 +++++
 6 files changed, 48 insertions(+), 1 deletion(-)

diff --git a/src/kosmickrisp/bridge/mtl_command_buffer.h b/src/kosmickrisp/bridge/mtl_command_buffer.h
index 2763b0e..d1d7ee6 100644
--- a/src/kosmickrisp/bridge/mtl_command_buffer.h
+++ b/src/kosmickrisp/bridge/mtl_command_buffer.h
@@ -12,6 +12,7 @@
 #include <stdint.h>
 
 void mtl_command_allocator_reset(mtl_command_allocator *allocator);
+uint64_t mtl_command_allocator_allocated_size(mtl_command_allocator *allocator);
 
 void mtl_begin_command_buffer(mtl_command_buffer *command_buffer,
                               mtl_command_allocator *allocator);
diff --git a/src/kosmickrisp/bridge/mtl_command_buffer.m b/src/kosmickrisp/bridge/mtl_command_buffer.m
index 2b342a0..ee0b6de 100644
--- a/src/kosmickrisp/bridge/mtl_command_buffer.m
+++ b/src/kosmickrisp/bridge/mtl_command_buffer.m
@@ -20,6 +20,14 @@ mtl_command_allocator_reset(mtl_command_allocator *allocator)
    }
 }
 
+uint64_t
+mtl_command_allocator_allocated_size(mtl_command_allocator *allocator)
+{
+   @autoreleasepool {
+      return [(id<MTL4CommandAllocator>)allocator allocatedSize];
+   }
+}
+
 void
 mtl_begin_command_buffer(mtl_command_buffer *command_buffer,
                          mtl_command_allocator *allocator)
diff --git a/src/kosmickrisp/bridge/stubs/mtl_command_buffer.c b/src/kosmickrisp/bridge/stubs/mtl_command_buffer.c
index 2fe1e3b..21b1157 100644
--- a/src/kosmickrisp/bridge/stubs/mtl_command_buffer.c
+++ b/src/kosmickrisp/bridge/stubs/mtl_command_buffer.c
@@ -11,6 +11,12 @@ mtl_command_allocator_reset(mtl_command_allocator *allocator)
 {
 }
 
+uint64_t
+mtl_command_allocator_allocated_size(mtl_command_allocator *allocator)
+{
+   return 0u;
+}
+
 void
 mtl_begin_command_buffer(mtl_command_buffer *command_buffer,
                          mtl_command_allocator *allocator)
diff --git a/src/kosmickrisp/vulkan/kk_cmd_buffer.c b/src/kosmickrisp/vulkan/kk_cmd_buffer.c
index f097d31..9be3f44 100644
--- a/src/kosmickrisp/vulkan/kk_cmd_buffer.c
+++ b/src/kosmickrisp/vulkan/kk_cmd_buffer.c
@@ -59,7 +59,8 @@ kk_cmd_release_resources(struct kk_device *dev, struct kk_cmd_buffer *cmd)
    util_dynarray_clear(&cmd->minmax_uab_sets);
 }
 
-/* Ends Metal command buffer recording and returns allocator to pool for reuse */
+/* Ends Metal command buffer recording. The allocator stays with the command
+ * buffer: its memory backs the recorded commands until the GPU ran them. */
 static void
 end_recording(struct kk_cmd_buffer *cmd)
 {
@@ -68,6 +69,18 @@ end_recording(struct kk_cmd_buffer *cmd)
 
    cs_end(cmd);
    mtl_end_command_buffer(cmd->metal.cmd_buf);
+}
+
+/* Reset or destroy: the command buffer is not pending (Vulkan), so the GPU is
+ * done with its commands. An allocator that is never reset keeps every command
+ * ever recorded with it, and grows without limit. */
+static void
+release_allocator(struct kk_cmd_buffer *cmd)
+{
+   if (cmd->metal.allocator == NULL)
+      return;
+
+   mtl_command_allocator_reset(cmd->metal.allocator);
    kk_cmd_pool_return_allocator(kk_cmd_buffer_pool(cmd), cmd->metal.allocator);
    cmd->metal.allocator = NULL;
 }
@@ -84,6 +97,7 @@ kk_destroy_cmd_buffer(struct vk_command_buffer *vk_cmd_buffer)
 
    /* Ensure closed command buffer for safe returns to pool */
    end_recording(cmd);
+   release_allocator(cmd);
    if (cmd->metal.cmd_buf)
       kk_cmd_pool_return_cmd_buf(pool, cmd->metal.cmd_buf);
    cmd->metal.cmd_buf = NULL;
@@ -167,6 +181,7 @@ kk_reset_cmd_buffer_internal(struct kk_cmd_buffer *cmd)
 
    /* Ensure closed command buffer so we can start it again */
    end_recording(cmd);
+   release_allocator(cmd);
    kk_cmd_release_resources(dev, cmd);
 
    cmd->uploader.bo = NULL;
diff --git a/src/kosmickrisp/vulkan/kk_cmd_pool.c b/src/kosmickrisp/vulkan/kk_cmd_pool.c
index e2c2fc8..f31ad16 100644
--- a/src/kosmickrisp/vulkan/kk_cmd_pool.c
+++ b/src/kosmickrisp/vulkan/kk_cmd_pool.c
@@ -101,6 +101,18 @@ void
 kk_cmd_pool_return_allocator(struct kk_cmd_pool *pool,
                              mtl_command_allocator *allocator)
 {
+   /* A Metal allocator keeps the memory of the largest recording it held, even
+    * after a reset, and vkd3d-proton has a command pool for each D3D12 command
+    * allocator: keep a few small allocators per pool for reuse and release the
+    * others, so that their memory goes back to the system. */
+   if (util_dynarray_num_elements(&pool->metal.free_allocators,
+                                  mtl_command_allocator *) >=
+          KK_CMD_POOL_ALLOCATOR_MAX ||
+       mtl_command_allocator_allocated_size(allocator) >
+          KK_CMD_POOL_ALLOCATOR_MAX_B) {
+      mtl_release(allocator);
+      return;
+   }
    util_dynarray_append(&pool->metal.free_allocators, allocator);
 }
 
diff --git a/src/kosmickrisp/vulkan/kk_cmd_pool.h b/src/kosmickrisp/vulkan/kk_cmd_pool.h
index 479e70e..66c50ba 100644
--- a/src/kosmickrisp/vulkan/kk_cmd_pool.h
+++ b/src/kosmickrisp/vulkan/kk_cmd_pool.h
@@ -16,6 +16,11 @@
 
 #define KK_CMD_BO_SIZE     (1024 * 128)
 #define KK_CMD_POOL_BO_MAX 32
+/* Reset Metal command allocators a pool keeps for reuse, and the largest one it
+ * keeps (kk_cmd_pool_return_allocator): at most 16 MiB per pool. A new
+ * allocator costs about 0.1 ms per recording. */
+#define KK_CMD_POOL_ALLOCATOR_MAX   4
+#define KK_CMD_POOL_ALLOCATOR_MAX_B (4ull << 20)
 
 /* Recyclable command buffer BO, used for both push buffers and upload */
 struct kk_cmd_bo {
-- 
2.43.0

