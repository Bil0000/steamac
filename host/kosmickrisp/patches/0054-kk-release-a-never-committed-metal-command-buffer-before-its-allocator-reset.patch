From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: steamac <steamac@local>
Date: Sun, 15 Nov 2026 20:05:00 +0300
Subject: [PATCH] kk: release a never committed Metal command buffer before its
 allocator reset

A Metal 4 command buffer that began and was never committed still owns the
command allocator memory of its recording. Since the allocator is reset when
its command buffer is reset or destroyed, a recorded command buffer that was
never submitted kept that stale Metal command buffer while the reset
allocator went to the next recording. When the stale one began again or was
released, Metal freed memory the other recording used, and that commit
crashed in -[IOGPUMetal4CommandBuffer fillCommandBufferArgs:].

vkd3d-proton leaves such command buffers for every closed D3D12 command list
that is never executed, then resets the pool. Release the uncommitted Metal
command buffer before the allocator reset and take a new one at the next
begin. Committed command buffers are reused as before.

Generated-by: LLM
---
 src/kosmickrisp/vulkan/kk_cmd_buffer.c | 19 +++++++++++++------
 src/kosmickrisp/vulkan/kk_cmd_buffer.h |  1 +
 src/kosmickrisp/vulkan/kk_queue.c      |  1 +
 3 files changed, 15 insertions(+), 6 deletions(-)

diff --git a/src/kosmickrisp/vulkan/kk_cmd_buffer.c b/src/kosmickrisp/vulkan/kk_cmd_buffer.c
index ea53c51..733bc93 100644
--- a/src/kosmickrisp/vulkan/kk_cmd_buffer.c
+++ b/src/kosmickrisp/vulkan/kk_cmd_buffer.c
@@ -80,6 +80,12 @@ release_allocator(struct kk_cmd_buffer *cmd)
    if (cmd->metal.allocator == NULL)
       return;
 
+   if (cmd->metal.uncommitted) {
+      mtl_release(cmd->metal.cmd_buf);
+      cmd->metal.cmd_buf = NULL;
+      cmd->metal.uncommitted = false;
+   }
+
    mtl_command_allocator_reset(cmd->metal.allocator);
    kk_cmd_pool_return_allocator(kk_cmd_buffer_pool(cmd), cmd->metal.allocator);
    cmd->metal.allocator = NULL;
@@ -217,6 +223,12 @@ kk_BeginCommandBuffer(VkCommandBuffer commandBuffer,
    VK_FROM_HANDLE(kk_cmd_buffer, cmd, commandBuffer);
    struct kk_cmd_pool *pool = kk_cmd_buffer_pool(cmd);
 
+   vk_command_buffer_begin(&cmd->vk, pBeginInfo);
+   cmd->one_time_submit =
+      pBeginInfo->flags & VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+   cmd->replay = false;
+   cmd->async_skipped = false;
+
    /* If this is the first time starting the command buffer allocate Metal
     * resources */
    if (cmd->metal.cmd_buf == NULL) {
@@ -230,12 +242,6 @@ kk_BeginCommandBuffer(VkCommandBuffer commandBuffer,
                                       cmd->vk.base.object_name);
    }
 
-   vk_command_buffer_begin(&cmd->vk, pBeginInfo);
-   cmd->one_time_submit =
-      pBeginInfo->flags & VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
-   cmd->replay = false;
-   cmd->async_skipped = false;
-
    /* vk_command_buffer_begin will reset the command buffer meaning the
     * allocator may be returned to the pool. Request a new one. */
    if (cmd->metal.allocator == NULL) {
@@ -245,6 +251,7 @@ kk_BeginCommandBuffer(VkCommandBuffer commandBuffer,
          goto fail_allocator;
    }
    mtl_begin_command_buffer(cmd->metal.cmd_buf, cmd->metal.allocator);
+   cmd->metal.uncommitted = true;
 
    return VK_SUCCESS;
 
diff --git a/src/kosmickrisp/vulkan/kk_cmd_buffer.h b/src/kosmickrisp/vulkan/kk_cmd_buffer.h
index 558d1d3..df8732c 100644
--- a/src/kosmickrisp/vulkan/kk_cmd_buffer.h
+++ b/src/kosmickrisp/vulkan/kk_cmd_buffer.h
@@ -265,6 +265,7 @@ struct kk_cmd_buffer {
       mtl_command_buffer *cmd_buf;
       mtl_render_encoder *render;
       mtl_compute_encoder *compute;
+      bool uncommitted;
    } metal;
    /* Pending timestamp resolves (struct kk_ts_resolve), flushed at cs_end. */
    struct util_dynarray ts_resolves;
diff --git a/src/kosmickrisp/vulkan/kk_queue.c b/src/kosmickrisp/vulkan/kk_queue.c
index 913f4a6..e7688a1 100644
--- a/src/kosmickrisp/vulkan/kk_queue.c
+++ b/src/kosmickrisp/vulkan/kk_queue.c
@@ -246,6 +246,7 @@ kk_queue_commit(struct kk_queue *queue, struct kk_cmd_buffer *cmd,
    mtl_commit_options *options = mtl_new_commit_options();
    mtl_commit_options_add_feedback_handler(options, callback, user_data, seq);
 
+   cmd->metal.uncommitted = false;
    mtl_command_queue_commit(queue->mtl_handle, &cmd->metal.cmd_buf, 1u,
                             options);
    mtl_release(options);
