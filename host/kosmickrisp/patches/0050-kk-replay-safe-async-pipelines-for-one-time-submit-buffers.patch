From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: steamac <steamac@local>
Date: Sat, 14 Nov 2026 21:56:21 +0300
Subject: [PATCH] kk: replay-safe async pipelines for one-time-submit buffers,
 one worker per CPU

MESA_KK_ASYNC_PIPELINES=1 skips a draw whose Metal render pipeline state is
still being built and re-records the command buffer from its command list at
submission. A ONE_TIME_SUBMIT command buffer keeps no command list
(kk_dispatch_cmd_gen.py only enqueues for reusable buffers), so that replay
was empty: the whole buffer was lost, its queries never became available and
vkGetQueryPoolResults timed out with VK_ERROR_DEVICE_LOST. DXVK and
vkd3d-proton record one-time-submit buffers every frame. Such a draw now
gets its state while it is recorded; the other pipelines keep compiling on
the workers.

A thread that needs a state (that draw, or a mode-1 replay) waited for the
job's fence, and the job may sit behind hundreds of others in the queue's
one FIFO. It now builds the state itself when no worker has started it; a
per-state lock makes the worker skip a state that is built already, so the
wait is at most that state's own compile.

A game creates most pipelines on one thread; its guest Venus ring reaches
the host on one thread, so the pipeline queue is the only parallelism
Metal's compiler gets. Four workers kept a game's first launch at four
concurrent compiles while one MTL4Compiler accepts 18 (M5 Pro); use one
worker per CPU, at least four.

macOS threads start at the default QoS whatever their creator runs at, and
MTLCompilerService compiles at its caller's QoS, so the workers' compiles
ran below the Venus threads (user-interactive, virglrenderer patch 0007)
that may wait for them. UTIL_QUEUE_INIT_USE_MINIMUM_PRIORITY only acts on
Linux. The workers now take the QoS class of the thread that creates the
device, at least user-initiated.
---
 src/kosmickrisp/vulkan/kk_device.c | 17 +++++++----
 src/kosmickrisp/vulkan/kk_device.h |  4 +++
 src/kosmickrisp/vulkan/kk_shader.c | 48 ++++++++++++++++++++----------
 src/kosmickrisp/vulkan/kk_shader.h | 20 ++++++++-----
 4 files changed, 61 insertions(+), 28 deletions(-)

diff --git a/src/kosmickrisp/vulkan/kk_device.c b/src/kosmickrisp/vulkan/kk_device.c
index 72378a1..1a90a76 100644
--- a/src/kosmickrisp/vulkan/kk_device.c
+++ b/src/kosmickrisp/vulkan/kk_device.c
@@ -32,6 +32,7 @@
 #include "vk_pipeline_cache.h"
 
 #include "util/os_time.h"
+#include "util/u_cpu_detect.h"
 
 #include <stdio.h>
 #include <time.h>
@@ -380,16 +381,22 @@ kk_CreateDevice(VkPhysicalDevice physicalDevice,
    /* MESA_KK_ASYNC_PIPELINES: read once, here, so the choice cannot change
     * under a pipeline that was already built (kk_compile_graphics_pipeline).
     * 1 makes a submission wait for a compile that a draw skipped over; 2 drops
-    * such a draw for good, so no thread ever waits for Metal. Four threads: the
-    * compiles are seconds long, and a device with no ready pipeline still
-    * stalls every draw of it. */
+    * such a draw for good, so no thread ever waits for Metal. A game creates
+    * most pipelines on one thread, whose guest Venus ring reaches this driver
+    * on one host thread, so these workers are the only parallelism Metal's
+    * compiler gets: one per CPU, at least four. macOS threads start at the
+    * default QoS whatever their creator runs at, and MTLCompilerService
+    * compiles at its caller's QoS; a recording thread may need a compile
+    * (kk_shader_async_draw_ok), so the workers take this thread's class, at
+    * least user-initiated. */
    const int64_t async_mode =
       debug_get_num_option("MESA_KK_ASYNC_PIPELINES", 0);
    dev->async_pipelines = async_mode != 0;
    dev->async_pipelines_never_wait = async_mode == 2;
+   dev->pipeline_qos = MAX2(qos_class_self(), QOS_CLASS_USER_INITIATED);
    if (dev->async_pipelines &&
-       !util_queue_init(&dev->pipeline_queue, "kk-pipe", 512, 4,
-                        UTIL_QUEUE_INIT_USE_MINIMUM_PRIORITY, dev)) {
+       !util_queue_init(&dev->pipeline_queue, "kk-pipe", 512,
+                        MAX2(4, util_get_cpu_caps()->nr_cpus), 0, dev)) {
       dev->async_pipelines = false;
       dev->async_pipelines_never_wait = false;
    }
diff --git a/src/kosmickrisp/vulkan/kk_device.h b/src/kosmickrisp/vulkan/kk_device.h
index 77f09cd..8080826 100644
--- a/src/kosmickrisp/vulkan/kk_device.h
+++ b/src/kosmickrisp/vulkan/kk_device.h
@@ -21,6 +21,8 @@
 #include "util/u_dynarray.h"
 #include "util/u_queue.h"
 
+#include <pthread/qos.h>
+
 #include "vk_device.h"
 #include "vk_meta.h"
 #include "vk_queue.h"
@@ -123,6 +125,8 @@ struct kk_device {
     * (kk_async_pipelines_never_wait). */
    bool async_pipelines_never_wait;
    struct util_queue pipeline_queue;
+   /* QoS class the workers run their jobs at (kk_async_pipeline_worker) */
+   qos_class_t pipeline_qos;
 
    /* os_time_get_nano() at creation (command queue error diagnostics) */
    int64_t created_ns;
diff --git a/src/kosmickrisp/vulkan/kk_shader.c b/src/kosmickrisp/vulkan/kk_shader.c
index 5ca2d97..6fca055 100644
--- a/src/kosmickrisp/vulkan/kk_shader.c
+++ b/src/kosmickrisp/vulkan/kk_shader.c
@@ -1658,6 +1658,7 @@ struct kk_async_job {
 static void
 kk_async_pipeline_free(struct kk_async_pipeline *async)
 {
+   simple_mtx_destroy(&async->lock);
    /* The MSL copies are ralloc children of the pipeline */
    ralloc_free(async->vs_msl.code);
    ralloc_free(async->vs_msl.entrypoint_name);
@@ -1666,9 +1667,8 @@ kk_async_pipeline_free(struct kk_async_pipeline *async)
    ralloc_free(async);
 }
 
-/* Builds the render pipeline state. Only a worker thread runs this, so no
- * recording or submission thread ever waits for Metal. Reads the MSL copy the
- * state owns and publishes the handle through pipe->gfx.render. */
+/* Builds the render pipeline state (kk_async_pipeline_run). Reads the MSL copy
+ * the state owns and publishes the handle through pipe->gfx.render. */
 static bool
 kk_async_pipeline_build(struct kk_device *dev, struct kk_async_pipeline *async)
 {
@@ -1689,15 +1689,30 @@ kk_async_pipeline_build(struct kk_device *dev, struct kk_async_pipeline *async)
    return true;
 }
 
+/* Builds the state unless it was built already, by the worker or by a thread
+ * that needed it before a worker started it. A second caller waits on the lock
+ * for that one compile only, never for the jobs queued before it. */
+static void
+kk_async_pipeline_run(struct kk_device *dev, struct kk_async_pipeline *async)
+{
+   simple_mtx_lock(&async->lock);
+   if (p_atomic_read(&async->status) == KK_ASYNC_PENDING) {
+      const bool built = kk_async_pipeline_build(dev, async);
+      p_atomic_set(&async->status,
+                   built ? (unsigned)KK_ASYNC_READY : (unsigned)KK_ASYNC_FAILED);
+   }
+   simple_mtx_unlock(&async->lock);
+}
+
 static void
 kk_async_pipeline_worker(void *job_data, void *gdata, int thread_index)
 {
    struct kk_async_job *job = job_data;
-   struct kk_async_pipeline *async = job->async;
 
-   const bool built = kk_async_pipeline_build(job->dev, async);
-   p_atomic_set(&async->status,
-                built ? (unsigned)KK_ASYNC_READY : (unsigned)KK_ASYNC_FAILED);
+   /* util_queue has no thread init hook: set the class (kk_CreateDevice) on
+    * every job, before the compile reaches MTLCompilerService. */
+   pthread_set_qos_class_self_np(job->dev->pipeline_qos, 0);
+   kk_async_pipeline_run(job->dev, job->async);
    /* Last access to async by this job: the fence is signalled after return. */
    job->ran = true;
 }
@@ -1828,6 +1843,7 @@ kk_compile_graphics_pipeline(struct kk_device *device, struct kk_shader *vs)
       struct kk_async_pipeline *async =
          rzalloc(NULL, struct kk_async_pipeline);
       if (likely(async != NULL)) {
+         simple_mtx_init(&async->lock, mtx_plain);
          async->pipe = pipe;
          async->topology = vs->info.vs.topology;
          memcpy(async->rt_formats, vs->info.vs.rt_formats,
@@ -2682,8 +2698,11 @@ kk_shader_async_draw_ok(struct kk_cmd_buffer *cmd, struct kk_shader *program,
    /* Still compiling, or ready but its handle is not visible to this thread
     * yet. The command queue's replay must not drop the draw a second time, and
     * it can wait: the compile was already paid for by the first recording of
-    * this command buffer. */
-   if (!cmd->replay) {
+    * this command buffer. A one-time-submit command buffer records no command
+    * queue (kk_dispatch_cmd_gen.py), so its replay would be empty and lose the
+    * whole buffer: it waits here instead, while the workers keep compiling the
+    * other pipelines. */
+   if (!cmd->replay && !cmd->one_time_submit) {
       if (KK_DEBUG(ASYNC) && !*not_ready)
          mesa_logi("kk: draw skipped: its pipeline's render pipeline state is "
                    "still being built");
@@ -2691,12 +2710,11 @@ kk_shader_async_draw_ok(struct kk_cmd_buffer *cmd, struct kk_shader *program,
       return KK_ASYNC_ACTION_REPLAY;
    }
 
-   /* The worker signals the fence after publishing the status (through
-    * p_atomic_set, a release store), so a status other than pending here means
-    * pipe->gfx.render is visible to this thread. The job also runs on the
-    * thread that drops it at device teardown, where the fence is signalled just
-    * the same. */
-   util_queue_fence_wait(&async->fence);
+   /* Build the state here if no worker started it yet: its job may be queued
+    * behind hundreds of others, and waiting for its fence would wait for all
+    * of them. Otherwise wait for the worker's compile. The status is set under
+    * the lock after pipe->gfx.render is published, so both are visible here. */
+   kk_async_pipeline_run(dev, async);
 
    if (unlikely(p_atomic_read(&async->status) != KK_ASYNC_READY ||
                 p_atomic_read(&program->pipeline.gfx.render) == NULL)) {
diff --git a/src/kosmickrisp/vulkan/kk_shader.h b/src/kosmickrisp/vulkan/kk_shader.h
index 88e5556..6b00338 100644
--- a/src/kosmickrisp/vulkan/kk_shader.h
+++ b/src/kosmickrisp/vulkan/kk_shader.h
@@ -15,6 +15,7 @@
 
 #include "poly/nir/poly_nir.h"
 
+#include "util/simple_mtx.h"
 #include "util/u_atomic.h"
 #include "util/u_queue.h"
 
@@ -164,8 +165,9 @@ struct msl_compile_data {
  * pipeline creation thread before the program is visible to any other thread,
  * waited for by kk_shader_destroy before the program releases (and thus before
  * anything the worker writes is freed). No other thread takes a reference: a
- * draw either finds the state ready, or skips the draw (kk_cmd_shader_pipeline)
- * without touching this. */
+ * draw either finds the state ready, skips the draw (kk_cmd_shader_pipeline),
+ * or, when it cannot skip it, builds the state itself or waits for the worker
+ * that is building it (kk_async_pipeline_run). */
 struct kk_async_pipeline {
    /* Where the worker publishes the state: the program's handles. */
    struct kk_pipeline_handles *pipe;
@@ -181,13 +183,15 @@ struct kk_async_pipeline {
    struct msl_compile_data vs_msl;
    struct msl_compile_data fs_msl;
 
-   /* Signalled by the worker after pipe->gfx.render is set, or by the queue
-    * when the job is dropped without running (device teardown). Only a
-    * submission that already re-recorded a command buffer (mode 1) and the
-    * program's own destruction wait on it; a draw never does. */
+   /* Signalled by the worker after its job ran, or by the queue when the job
+    * is dropped without running (device teardown). Only the program's own
+    * destruction waits on it. */
    struct util_queue_fence fence;
-   /* KK_ASYNC_PENDING, KK_ASYNC_READY or KK_ASYNC_FAILED; read by every draw
-    * without waiting (kk_shader_async_draw_ok). */
+   /* Held by whichever thread builds the state: the worker, or a recording or
+    * submission thread that needs it first (kk_async_pipeline_run). */
+   simple_mtx_t lock;
+   /* KK_ASYNC_PENDING, KK_ASYNC_READY or KK_ASYNC_FAILED; set under `lock`,
+    * read by every draw without waiting (kk_shader_async_draw_ok). */
    unsigned status;
 };
 
