From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: steamac <steamac@local>
Date: Sat, 14 Nov 2026 18:33:45 +0300
Subject: [PATCH] kk: free the timestamp chunks of a destroyed device's pools

Timestamp query pools take chunks of the process' 32 shared Metal counter
heaps (0037), returned only by vkDestroyQueryPool. Under virglrenderer a
guest application that exits or crashes has its VkDevice destroyed with its
pools still alive (vkr_device_destroy never destroys tracked objects on the
render thread: on_worker_thread is false there), so their chunks stayed used
for the life of the VMM. vkd3d-proton creates timestamp pools of 8192
(256 chunks each); a few game launches used every chunk, the next
vkCreateQueryPool failed ("Failed to create timestamp counter heap: ...
too many heaps already allocated in this process or on the system") and
Venus lost the pool: Bodycam closed itself about a minute after its second
start in the same FX session, with no crash report.

Each used chunk records its device; kk_DestroyDevice returns every chunk the
device still holds. Repro: a process that creates a device with four
timestamp pools of 8192, submits a timestamp to each and destroys the device
without destroying the pools failed vkCreateQueryPool in its 7th round.
---
 src/kosmickrisp/vulkan/kk_device.c     |  2 ++
 src/kosmickrisp/vulkan/kk_query_pool.c | 27 +++++++++++++++++++++++++-
 src/kosmickrisp/vulkan/kk_query_pool.h |  2 ++
 3 files changed, 30 insertions(+), 1 deletion(-)

diff --git a/src/kosmickrisp/vulkan/kk_device.c b/src/kosmickrisp/vulkan/kk_device.c
index ff91cc3..72378a1 100644
--- a/src/kosmickrisp/vulkan/kk_device.c
+++ b/src/kosmickrisp/vulkan/kk_device.c
@@ -16,6 +16,7 @@
 #include "kk_image_view.h"
 #include "kk_instance.h"
 #include "kk_physical_device.h"
+#include "kk_query_pool.h"
 #include "kk_shader.h"
 
 #include "kosmickrisp/bridge/mtl_bridge.h"
@@ -488,6 +489,7 @@ kk_DestroyDevice(VkDevice _device, const VkAllocationCallbacks *pAllocator)
    kk_device_finish_meta(dev);
    kk_device_finish_lib(dev);
    kk_oq_heap_finish(dev, &dev->occlusion_queries);
+   kk_ts_free_device_chunks(dev);
    kk_destroy_sampler_heap(dev, &dev->samplers);
 
    /* Geometry heap */
diff --git a/src/kosmickrisp/vulkan/kk_query_pool.c b/src/kosmickrisp/vulkan/kk_query_pool.c
index caa6963..adfe414 100644
--- a/src/kosmickrisp/vulkan/kk_query_pool.c
+++ b/src/kosmickrisp/vulkan/kk_query_pool.c
@@ -43,6 +43,9 @@ static struct {
    uint32_t heap_count;
    mtl_counter_heap *heaps[KK_TS_HEAP_COUNT];
    BITSET_DECLARE(used, KK_TS_CHUNK_COUNT);
+   /* Device of each used chunk: chunks of pools still alive when their
+    * device is destroyed are returned by kk_ts_free_device_chunks. */
+   const struct kk_device *owner[KK_TS_CHUNK_COUNT];
 } kk_ts_slots = {.mutex = SIMPLE_MTX_INITIALIZER};
 
 static uint32_t
@@ -92,6 +95,7 @@ kk_ts_alloc_chunks(struct kk_device *dev, uint16_t *chunks, uint32_t count)
    for (uint32_t c = 0; n < count; c++) {
       if (!BITSET_TEST(kk_ts_slots.used, c)) {
          BITSET_SET(kk_ts_slots.used, c);
+         kk_ts_slots.owner[c] = dev;
          chunks[n++] = c;
       }
    }
@@ -105,8 +109,29 @@ static void
 kk_ts_free_chunks(const uint16_t *chunks, uint32_t count)
 {
    simple_mtx_lock(&kk_ts_slots.mutex);
-   for (uint32_t i = 0; i < count; i++)
+   for (uint32_t i = 0; i < count; i++) {
       BITSET_CLEAR(kk_ts_slots.used, chunks[i]);
+      kk_ts_slots.owner[chunks[i]] = NULL;
+   }
+   simple_mtx_unlock(&kk_ts_slots.mutex);
+}
+
+/* Returns the chunks of timestamp pools the application never destroyed.
+ * Under virglrenderer a guest application that exits (or crashes) has its
+ * device destroyed with its pools still alive; their chunks stayed used for
+ * the life of the VMM, and after a few game launches every timestamp pool
+ * failed ("too many heaps already allocated") and the game's GPU context
+ * was lost. */
+void
+kk_ts_free_device_chunks(const struct kk_device *dev)
+{
+   simple_mtx_lock(&kk_ts_slots.mutex);
+   for (uint32_t c = 0; c < KK_TS_CHUNK_COUNT; c++) {
+      if (kk_ts_slots.owner[c] == dev) {
+         BITSET_CLEAR(kk_ts_slots.used, c);
+         kk_ts_slots.owner[c] = NULL;
+      }
+   }
    simple_mtx_unlock(&kk_ts_slots.mutex);
 }
 
diff --git a/src/kosmickrisp/vulkan/kk_query_pool.h b/src/kosmickrisp/vulkan/kk_query_pool.h
index 489a937..5c246a7 100644
--- a/src/kosmickrisp/vulkan/kk_query_pool.h
+++ b/src/kosmickrisp/vulkan/kk_query_pool.h
@@ -49,5 +49,7 @@ VK_DEFINE_NONDISP_HANDLE_CASTS(kk_query_pool, vk.base, VkQueryPool,
                                VK_OBJECT_TYPE_QUERY_POOL)
 
 uint32_t *kk_pool_index_ptr(const struct kk_query_pool *pool);
+struct kk_device;
+void kk_ts_free_device_chunks(const struct kk_device *dev);
 
 #endif /* KK_QUERY_POOL_H */
-- 
