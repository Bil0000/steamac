From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: steamac <steamac@local>
Date: Sat, 14 Nov 2026 02:00:00 +0100
Subject: [PATCH] virtio/gpu: change a display's refresh rate at runtime

Add krun_display_set_mode(ctx, display, width, height, width_mm,
height_mm, refresh_rate): krun_display_resize() plus a new refresh rate
for the generated EDID's preferred mode (0 keeps the current one). It
uses the same queue, display event and configuration change interrupt,
so Linux picks up the new mode with the same DRM hotplug.

The host launcher calls it when its window moves to a screen with
another refresh rate, so the guest compositor and games pace frames for
the screen they are shown on instead of the one the VM booted on.
krun_display_resize() is now krun_display_set_mode() with rate 0.
---
 include/libkrun.h                     | 19 +++++++++++++
 src/devices/src/virtio/gpu/display.rs | 41 +++++++++++++++++++++++++--
 src/libkrun/src/lib.rs                | 31 +++++++++++++++++++-
 3 files changed, 88 insertions(+), 3 deletions(-)

diff --git a/include/libkrun.h b/include/libkrun.h
index 3dc3d39..8718fd3 100644
--- a/include/libkrun.h
+++ b/include/libkrun.h
@@ -762,6 +762,25 @@ int32_t krun_display_set_physical_size(uint32_t ctx_id, uint32_t display_id, uin
 int32_t krun_display_resize(uint32_t ctx_id, uint32_t display_id, uint32_t width, uint32_t height,
                             uint16_t width_mm, uint16_t height_mm);
 
+/**
+ * Change the size and the refresh rate of a display, also while the VM runs.
+ *
+ * As krun_display_resize(), and the preferred detailed timing of the regenerated EDID gets
+ * "refresh_rate" Hz (for example when the host window moves to a screen with another refresh
+ * rate). Linux sees the new mode after the same display-change notification. A mode too large
+ * for the base EDID pixel clock at this rate keeps a lower rate there and gets the requested
+ * one in a DisplayID timing extension.
+ *
+ * Arguments:
+ *  as krun_display_resize(), and
+ *  "refresh_rate" - refresh rate in Hz, 1..1000; 0 keeps the current rate
+ *
+ * Returns:
+ *  as krun_display_resize(); -EINVAL also for a refresh rate above 1000
+ */
+int32_t krun_display_set_mode(uint32_t ctx_id, uint32_t display_id, uint32_t width, uint32_t height,
+                              uint16_t width_mm, uint16_t height_mm, uint32_t refresh_rate);
+
 /**
  * Read the GPU activity counters of a running VM (any thread, cheap: two relaxed loads).
  * Both are running totals (ring commands count every context of the process); a host
diff --git a/src/devices/src/virtio/gpu/display.rs b/src/devices/src/virtio/gpu/display.rs
index 598445c..3a3f39a 100644
--- a/src/devices/src/virtio/gpu/display.rs
+++ b/src/devices/src/virtio/gpu/display.rs
@@ -72,12 +72,18 @@ impl DisplayInfo {
             return Err(DisplayResizeError::FixedEdid);
         };
         let physical_size = PhysicalSize::DimensionsMillimeters(resize.width_mm, resize.height_mm);
+        let refresh_rate = match resize.refresh_rate {
+            0 => params.refresh_rate,
+            hz => hz,
+        };
         let changed = self.width != resize.width
             || self.height != resize.height
-            || params.physical_size != physical_size;
+            || params.physical_size != physical_size
+            || params.refresh_rate != refresh_rate;
         self.width = resize.width;
         self.height = resize.height;
         params.physical_size = physical_size;
+        params.refresh_rate = refresh_rate;
         Ok(changed)
     }
 }
@@ -86,6 +92,9 @@ impl DisplayInfo {
 /// can describe: its detailed timing descriptor has 12-bit fields.
 pub const MAX_RESIZE_DIMENSION: u32 = 4095;
 
+/// The highest refresh rate a runtime change accepts.
+pub const MAX_REFRESH_RATE: u32 = 1000;
+
 /// A display size change requested at runtime (krun_display_resize).
 #[derive(Clone, Copy, Debug, PartialEq, Eq)]
 pub struct DisplayResize {
@@ -94,11 +103,14 @@ pub struct DisplayResize {
     pub height: u32,
     pub width_mm: u16,
     pub height_mm: u16,
+    /// New refresh rate in Hz for the EDID's preferred mode; 0 keeps the current one.
+    pub refresh_rate: u32,
 }
 
 #[derive(Clone, Copy, Debug, PartialEq, Eq)]
 pub enum DisplayResizeError {
-    /// Zero size, or larger than MAX_RESIZE_DIMENSION.
+    /// Zero size, larger than MAX_RESIZE_DIMENSION, or a refresh rate above
+    /// MAX_REFRESH_RATE.
     InvalidSize,
     /// No display with this id.
     InvalidDisplay,
@@ -114,6 +126,7 @@ impl DisplayResize {
             || !fits(self.height)
             || u32::from(self.width_mm) > MAX_RESIZE_DIMENSION
             || u32::from(self.height_mm) > MAX_RESIZE_DIMENSION
+            || self.refresh_rate > MAX_REFRESH_RATE
         {
             return Err(DisplayResizeError::InvalidSize);
         }
@@ -325,9 +338,33 @@ mod tests {
             height,
             width_mm,
             height_mm,
+            refresh_rate: 0,
         }
     }
 
+    #[test]
+    fn resize_changes_the_refresh_rate() {
+        let mut display = DisplayInfo::new(1280, 800);
+        let at = |hz| DisplayResize {
+            refresh_rate: hz,
+            ..resize(1280, 800, 339, 212)
+        };
+        assert_eq!(display.resize(&at(0)), Ok(true));
+        assert_eq!(display.resize(&at(120)), Ok(true));
+        assert_eq!(display.resize(&at(120)), Ok(false));
+        let (.., hz, _, _) = preferred_mode(&display.edid_bytes());
+        assert!((hz - 120.0).abs() < 0.5, "{hz} Hz");
+        // 0 keeps the rate, also across a size change.
+        assert_eq!(display.resize(&at(0)), Ok(false));
+        display.resize(&resize(1600, 1000, 423, 265)).unwrap();
+        let (.., hz, _, _) = preferred_mode(&display.edid_bytes());
+        assert!((hz - 120.0).abs() < 0.5, "{hz} Hz");
+        assert_eq!(
+            display.resize(&at(MAX_REFRESH_RATE + 1)),
+            Err(DisplayResizeError::InvalidSize)
+        );
+    }
+
     #[test]
     fn resize_regenerates_edid() {
         let mut display = DisplayInfo::new(1280, 800);
diff --git a/src/libkrun/src/lib.rs b/src/libkrun/src/lib.rs
index 1e05ef3..ed8a05a 100644
--- a/src/libkrun/src/lib.rs
+++ b/src/libkrun/src/lib.rs
@@ -1914,6 +1914,20 @@ pub extern "C" fn krun_display_resize(
     height: u32,
     width_mm: u16,
     height_mm: u16,
+) -> i32 {
+    krun_display_set_mode(ctx_id, display_id, width, height, width_mm, height_mm, 0)
+}
+
+#[cfg(feature = "gpu")]
+#[no_mangle]
+pub extern "C" fn krun_display_set_mode(
+    ctx_id: u32,
+    display_id: u32,
+    width: u32,
+    height: u32,
+    width_mm: u16,
+    height_mm: u16,
+    refresh_rate: u32,
 ) -> i32 {
     let resize = DisplayResize {
         display_id,
@@ -1921,6 +1935,7 @@ pub extern "C" fn krun_display_resize(
         height,
         width_mm,
         height_mm,
+        refresh_rate,
     };
     // Lock order: CTX_MAP, then DISPLAY_CONTROLS (as in krun_start_enter).
     let mut ctx_map = CTX_MAP.lock().unwrap();
@@ -1942,7 +1957,7 @@ pub extern "C" fn krun_display_resize(
     match result {
         Ok(()) => KRUN_SUCCESS,
         Err(e) => {
-            debug!("krun_display_resize({ctx_id}, {resize:?}): {e:?}");
+            debug!("krun_display_set_mode({ctx_id}, {resize:?}): {e:?}");
             -libc::EINVAL
         }
     }
@@ -1961,6 +1976,20 @@ pub extern "C" fn krun_display_resize(
     -libc::ENOTSUP
 }
 
+#[cfg(not(feature = "gpu"))]
+#[no_mangle]
+pub extern "C" fn krun_display_set_mode(
+    _ctx_id: u32,
+    _display_id: u32,
+    _width: u32,
+    _height: u32,
+    _width_mm: u16,
+    _height_mm: u16,
+    _refresh_rate: u32,
+) -> i32 {
+    -libc::ENOTSUP
+}
+
 /// virglrenderer's `uint64_t virgl_steamac_cmd_count(void)` (dispatched Venus commands,
 /// steamac virglrenderer patch 0009); None with a virglrenderer that does not export it.
 #[cfg(feature = "gpu")]
