+                gate.recv().ok();
+                Ok(())
+            })
+            .unwrap_err();
+        assert!(
+            matches!(err, Error::UnexpectedAudioBackendError(_)),
+            "{err}"
+        );
+        assert!(start.elapsed() >= CTL && start.elapsed() < CTL * 3);
+
+        let start = Instant::now();
+        let busy = backend.unit_job(0, "again", |_, _, _| Ok(())).unwrap_err();
+        assert!(start.elapsed() < CTL / 2, "busy must fail at once: {busy}");
+
+        release.send(()).unwrap();
+        wait_for("the stuck job to finish", Duration::from_secs(2), || {
+            !backend.inner.hosts[0].lock().unwrap().unit_busy
+        });
+        backend.unit_job(0, "after", |_, _, _| Ok(())).unwrap();
+    }
+
+    /// A control request answers (with an error) within the deadline even when the pump holds
+    /// `hosts` in a call that does not return. (Before: `hosts.lock()` waited for ever, the
+    /// device's worker thread with it, and every control message of the guest timed out.)
+    #[test]
+    fn control_requests_do_not_wait_for_a_stuck_pump() {
+        let backend = Arc::new(backend(CTL, Duration::from_secs(60)));
+        let _stuck = StuckPump::new(&backend);
+        let ops: [(&str, &dyn Fn() -> Result<()>); 4] = [
+            ("prepare", &|| backend.prepare(0)),
+            ("release", &|| backend.release(0)),
+            ("start", &|| backend.start(0)),
+            ("stop", &|| backend.stop(0)),
+        ];
+        for (what, op) in ops {
+            let start = Instant::now();
+            assert!(op().is_err(), "{what} must fail while the pump is stuck");
+            assert!(
+                start.elapsed() < CTL * 3,
+                "{what} took {:?}",
+                start.elapsed()
+            );
+        }
+    }
+
+    /// A control request that fails (here: the pump holds `hosts` past the deadline) completes
+    /// the stream's queued I/O with IO_ERR. Held, it would keep the guest's I/O queue busy and the
+    /// driver would refuse every further PREPARE with "invalid I/O queue state" while the device
+    /// waits for that PREPARE to flush it.
+    #[test]
+    fn failed_control_request_releases_the_guests_queued_io() {
+        let backend = Arc::new(backend(CTL, Duration::from_secs(60)));
+        let _stuck = StuckPump::new(&backend);
+        let message = queue_message(&backend);
+        assert!(backend.prepare(0).is_err());
+        assert!(completed(&message), "the failed PREPARE left I/O queued");
+        assert_eq!(message.status.load(Ordering::SeqCst), VIRTIO_SND_S_IO_ERR);
+    }
+
+    /// The deadline rescues a call that never returns; it must not fire on the seconds an
+    /// AudioUnit start takes under load (lean run A_N19: "prepare took more than 2s", then the
+    /// guest's queue-state storm), and it must stay below the launcher's 10 s guest timeout.
+    #[test]
+    fn control_deadline_leaves_room_for_a_loaded_hal() {
+        assert!(CTL_DEADLINE >= Duration::from_secs(5));
+        assert!(CTL_DEADLINE < Duration::from_secs(10));
+    }
+
+    /// Queued I/O is failed with IO_ERR when the pump stops making progress, so the guest's
+    /// queues drain. (Before: nothing completed it; the guest kept "invalid I/O queue state"
+    /// for ever.)
+    #[test]
+    fn watchdog_fails_io_while_the_pump_is_stuck() {
+        let backend = Arc::new(backend(CTL, STALL));
+        let _stuck = StuckPump::new(&backend);
+        // Hold the pump in the same stuck call: it is waiting for `hosts` once it wakes.
+        let message = queue_message(&backend);
+        wait_for("the watchdog to fail the message", STALL * 10, || {
+            completed(&message)
+        });
+        assert_eq!(message.status.load(Ordering::SeqCst), VIRTIO_SND_S_IO_ERR);
+    }
+
+    /// An idle but healthy pump (it only wakes every HOUSEKEEPING) is not mistaken for a stuck
+    /// one.
+    #[test]
+    fn watchdog_leaves_a_healthy_pump_alone() {
+        let streams = Arc::new(RwLock::new(vec![Stream::default()]));
+        let backend = CoreAudioBackend::with_deadlines(
+            streams,
+            Arc::new(SndControl::default()),
+            CTL,
+            Duration::from_millis(1500),
+        )
+        .unwrap();
+        // Sample the heartbeat for longer than the stall threshold: the pump idles in 1 s waits.
+        let start = Instant::now();
+        while start.elapsed() < Duration::from_millis(2500) {
+            assert!(
+                backend.inner.stalled_for(0) < Duration::from_millis(1500),
+                "an idle pump looks stuck"
+            );
+            std::thread::sleep(Duration::from_millis(50));
+        }
+    }
+}
